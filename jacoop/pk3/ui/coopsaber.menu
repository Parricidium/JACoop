// JACoop - CHOIX DU MANCHE : tous les sabres installes (ext_data/sabers/*.sab, mods
// compris) avec leur nom, filtres par le type de sabre de l ecran, et l apercu 3D du jeu.
// Ouvert depuis l ecran SABRE. Genere par dist/gen_coop_menus.py.
{
	menuDef
	{
		name					"coopSaberHilts"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor				1 1 1 1
		descX					320
		descY					424
		descScale				1
		descColor				1 1 1 .75
		descAlignment			ITEM_ALIGN_CENTER
		onOpen
		{
			uiScript			coopHiltsInit
		}
		onESC
		{
			play				"sound/interface/menuroam.wav" ;
			uiScript			coopHiltCancel ;
			uiScript			coopHiltDone ;
			uiScript			coopHiltReturn
		}

		// --- decor ------------------------------------------------------
		itemDef
		{
			name				background
			group				grp_background
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"gfx/jacoop/panel_bg"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				button_glow
			group				mods
			style				WINDOW_STYLE_FILLED
			rect				0 0 0 0
			backcolor			1 1 1 1
			forecolor			1 1 1 1
			visible				0
			decoration
		}
		itemDef
		{
			name				title
			style				WINDOW_STYLE_EMPTY
			rect				0 24 640 30
			cvar				"ui_coopHiltTitle"
			font				3
			textscale			1.2
			textalign			ITEM_ALIGN_CENTER
			textalignx			320
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				countLabel
			style				WINDOW_STYLE_EMPTY
			rect				320 60 300 16
			cvar				"ui_coopHiltCount"
			font				3
			textscale			0.6
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			forecolor			1 1 1 .6
			visible				1
			decoration
		}
		itemDef
		{
			name				hiltList
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			rect				320 80 300 330
			feeder				0x1d
			elementwidth		300
			elementheight		16
			elementtype			LISTBOX_TEXT
			textscale			0.65
			forecolor			1 1 1 .82
			backcolor			0 0 0 .45
			outlinecolor		.6 .5 .3 .5
			border				1
			bordercolor			.45 .38 .25 1
			visible				1
		}
		itemDef
		{
			name				saber
			group				models
			type				ITEM_TYPE_MODEL
			rect				10 120 300 300
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber 			1
			model_angle			180
			model_rotation		20
			model_g2mins		0 0 0
			model_g2maxs		20 20 20
			model_fovx			75
			model_fovy			75
			cvarTest			ui_coopHiltWhich
			hideCvar			{ "2" }
			visible				1
			decoration
		}
		itemDef
		{
			name				saber2
			group				models
			type				ITEM_TYPE_MODEL
			rect				10 120 300 300
			asset_model			"models/weapons2/saber_1/saber_1.glm"
			isSaber2			1
			model_angle			180
			model_rotation		20
			model_g2mins		0 0 0
			model_g2maxs		20 20 20
			model_fovx			75
			model_fovy			75
			cvarTest			ui_coopHiltWhich
			hideCvar			{ "1" }
			visible				1
			decoration
		}
		itemDef
		{
			name				hint
			style				WINDOW_STYLE_EMPTY
			rect				30 412 600 16
			text				"@JACOOP_LES_AUTRES_JOUEURS_VOIENT_CE_MANCHE_S_IL"
			font				3
			textscale			0.5
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			forecolor			1 1 1 .6
			visible				1
			decoration
		}
		itemDef
		{
			name				backButton
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				30 440 160 24
			text				"@JACOOP_RETOUR"
			descText			"@JACOOP_REVENIR_SANS_CHANGER_DE_MANCHE"
			font				3
			textscale			0.9
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				uiScript				coopHiltCancel ;
				uiScript				coopHiltDone ;
				uiScript				coopHiltReturn
			}
		}
		itemDef
		{
			name				applyButton
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				450 440 160 24
			text				"@JACOOP_VALIDER"
			descText			"@JACOOP_GARDER_CE_MANCHE"
			font				3
			textscale			0.9
			textalign			ITEM_ALIGN_RIGHT
			textalignx			160
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				uiScript		coopHiltDone ;
				uiScript		coopHiltReturn
			}
		}
	}
}
