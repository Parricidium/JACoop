			font				3
			textscale			0.9
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			forecolor			1 1 1 1
			cvarTest			"ui_coopEndHost"
			showCvar			{ "1" }
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				uiScript		coopEndGo
			}
		}
