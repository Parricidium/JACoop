// JACoop - PERSONNAGE / SKIN : tous les modeles de joueur installes (models/players/*, pk3 de
// skins compris) avec leurs variantes, le portrait et un apercu 3D. Ouvert depuis le salon ou le
// menu F6 ; ui_coopForceFrom (lobby/game) dit ou revenir. Genere par dist/gen_coop_menus.py.
{
	menuDef
	{
		name					"coopSkins"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor				1 1 1 1
		descX					320
		descY					424
		descScale				1
		descColor				1 1 1 .75
		descAlignment			ITEM_ALIGN_CENTER
		onOpen
		{
			uiScript			coopModelsInit
		}
		onESC
		{
			play				"sound/interface/menuroam.wav" ;
			uiScript			coopForceBack
		}

		// --- decor ------------------------------------------------------
