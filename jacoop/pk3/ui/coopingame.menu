			textalignx			320
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				lobbyButton
			group				column
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				50 90 220 26
			text				"@JACOOP_SALON_JOUEURS"
			descText			"@JACOOP_QUI_EST_LA_QUI_EST_PRET_L_HOTE_Y_LANCE_O"
			font				3
			textscale			1.0
			textaligny			0
			textalign			ITEM_ALIGN_LEFT
			textstyle			1
			textalignx			8
			forecolor			1 1 1 1
			visible				1
			mouseEnter
			{
				show			button_glow
				setitemrect		button_glow	30 87 260 32
			}
			mouseExit
			{
				hide			button_glow
			}
			action
			{
				play			"sound/interface/button1.wav" ;
				close			all ;
				open			coopLobby
			}
		}
